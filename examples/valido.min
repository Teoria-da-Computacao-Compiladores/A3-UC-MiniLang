# Programa válido: usa declarações, atribuição, condicional, repetição,
# leitura e escrita. Não deve gerar nenhum erro léxico.
programa exemplo {
  var x: inteiro;
  var ok: booleano;
  x = 10 + 2 * 3;
  ok = verdadeiro e não falso;
  se (x >= 10) {
    escreva(x);
  } senão {
    leia(x);
  }
  enquanto (x > 0) {
    x = x - 1;
  }
} fim.
