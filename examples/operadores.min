# Todos os operadores da MiniLang, usados dentro de atribuições.
programa operadores {

    var x: inteiro;
    var y: inteiro;
    var r: inteiro;
    var b: booleano;

    x = 10;
    y = 3;

    # aritméticos
    r = x + y;
    r = x - y;
    r = x * y;
    r = x / y;
    r = x % y;

    # relacionais (lookahead: = / ==, < / <=, > / >=, !=)
    b = x == y;
    b = x != y;
    b = x < y;
    b = x <= y;
    b = x > y;
    b = x >= y;

    # lógicos
    b = verdadeiro e não falso;
    b = (x > y) ou (x == y);

} fim.
